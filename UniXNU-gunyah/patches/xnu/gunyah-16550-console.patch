+static volatile uint8_t *gunyah_uart;
+static void gunyah_uart_init(void) { gunyah_16550_init(gunyah_uart); __asm__ volatile("dsb sy" ::: "memory"); }
+static unsigned int gunyah_uart_tx_ready(void) { return gunyah_16550_tx_ready(gunyah_uart); }
+static void gunyah_uart_tx(uint8_t c) { gunyah_16550_tx(gunyah_uart, c); }
+static unsigned int gunyah_uart_rx_ready(void) { return gunyah_16550_rx_ready(gunyah_uart); }
+static uint8_t gunyah_uart_rx(void) { return gunyah_16550_rx(gunyah_uart); }
+SECURITY_READ_ONLY_LATE(static struct pe_serial_functions) gunyah_serial_functions = {
+	.init = gunyah_uart_init,
+	.transmit_ready = gunyah_uart_tx_ready,
+	.transmit_data = gunyah_uart_tx,
+	.receive_ready = gunyah_uart_rx_ready,
+	.receive_data = gunyah_uart_rx,
+	/* This build selects Gunyah exclusively; no PI3 device is registered. */
+	.device = SERIAL_PI3_UART,
+};
+static int gunyah_serial_init(void)
+{
+	DTEntry entry;
+	void const *data;
+	unsigned int size;
+	uint64_t reg[2];
+	if (SecureDTLookupEntry(NULL, "/gunyah-uart", &entry) != kSuccess ||
+	    SecureDTGetProperty(entry, "compatible", &data, &size) != kSuccess ||
+	    size != sizeof("ns16550a") || memcmp(data, "ns16550a", size) != 0 ||
+	    SecureDTGetProperty(entry, "reg", &data, &size) != kSuccess || size != sizeof(reg)) {
+		return 0;
+	}
+	memcpy(reg, data, sizeof(reg));
+	if (!gunyah_16550_valid_reg(reg[0], reg[1])) { return 0; }
+	gunyah_uart = (volatile uint8_t *)ml_io_map(reg[0], reg[1]);
+	if (gunyah_uart == NULL) { return 0; }
+	register_serial_functions(&gunyah_serial_functions);
+	gunyah_uart_init();
+	serial_do_transmit = 1;
+	uart_initted = true;
+	return 1;
+}
+#endif
