+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+/* Byte-spaced, byte-access ns16550a, with firmware baud rate preserved. */
+#ifndef GUNYAH_UART_H
+#define GUNYAH_UART_H
+static inline int gunyah_16550_valid_reg(uint64_t base, uint64_t size) {
+	return base != 0 && base < 0x100000000ULL && size == 8 && (base & 4095) <= 4088;
+}
+static inline void gunyah_16550_init(volatile uint8_t *p) {
+	p[3] &= (uint8_t)~0x80U; /* DLAB off before touching IER; preserve framing. */
+	p[1] = 0; /* Polling only. */
+}
+static inline unsigned int gunyah_16550_tx_ready(volatile uint8_t *p) { return p[5] & 0x20; }
+static inline void gunyah_16550_tx(volatile uint8_t *p, uint8_t c) { p[0] = c; }
+static inline unsigned int gunyah_16550_rx_ready(volatile uint8_t *p) { return p[5] & 1; }
+static inline uint8_t gunyah_16550_rx(volatile uint8_t *p) { return p[0]; }
+#endif
