+    } else {
+      thread_t thread;
+      kern_return_t result = kernel_thread_start (&gunyahTimerSelftest, nullptr, &thread);
+      if (result == KERN_SUCCESS) { thread_deallocate (thread); }
+      else { IOLog ("GUNYAH-TIMER: result=FAIL (thread creation %d)\n", result); }
+    }
+  }
